    "The first selected photo moves to this date and time. The same time offset is applied to the others.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first selected photo moves to this date and time. The same time offset is applied to the others."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一张所选照片会移到此日期和时间，其余照片按相同时间偏移调整。"
          }
        }
      }
    },
    "The original is kept in the Backup Bin, and iOS asks you to confirm deleting it from your library.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original is kept in the Backup Bin, and iOS asks you to confirm deleting it from your library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原图会保存在备份箱中，iOS 会请你确认是否从图库中删除。"
          }
        }
      }
    },
    "The photo moves to Recently Deleted in Photos.": {
      "extractionState": "manual",
