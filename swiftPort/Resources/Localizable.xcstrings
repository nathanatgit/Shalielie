            "state": "translated",
            "value": "所有所选照片都将使用此日期和时间。"
          }
        }
      }
    },
    "Allow access to your photos in Settings to browse your albums.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to your photos in Settings to browse your albums."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问照片以浏览相簿。"
          }
        }
      }
    },
    "Allow access to your photos in Settings to read the original HEIC and Live Photo video.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to your photos in Settings to read the original HEIC and Live Photo video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问照片，以读取 HEIC 原图和实况照片视频。"
          }
        }
      }
    },
    "Allow adding to your photo library in Settings to save the result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow adding to your photo library in Settings to save the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许添加到照片图库，以保存结果。"
          }
        }
      }
    },
    "Already has a Photographic Style; saved unchanged with its video as a Live Photo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already has a Photographic Style; saved unchanged with its video as a Live Photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有摄影风格；已连同视频原样存为实况照片。"
          }
        }
      }
    },
    "Already has a style and Texture & Grain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already has a style and Texture & Grain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有风格和质感与颗粒"
          }
        }
      }
    },
    "Analyze Each Photo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze Each Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析每张照片"
          }
        }
      }
    },
    "Analyzing measures the photo's own tones for the palette instead of using the reference photo's. Texture & Grain adds the iOS 27 controls, and Soft Skin when the photo has the face data for it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing measures the photo's own tones for the palette instead of using the reference photo's. Texture & Grain adds the iOS 27 controls, and Soft Skin when the photo has the face data for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析会根据照片自身的色调生成色板，而不是使用参考照片的色调。质感与颗粒会添加 iOS 27 的相关控制项；当照片有人脸数据时，还会添加“柔肤”。"
          }
        }
      }
    },
